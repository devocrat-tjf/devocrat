{
  "name": "Devocrat Restaurant & Bar",
  "short_name": "Devocrat",
  "description": "QR table ordering, kitchen display, live orders and reports for Devocrat Restaurant & Bar.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#1D130F",
  "theme_color": "#221611",
  "categories": ["food", "business", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Kitchen display", "url": "/?tab=kitchen", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Floor map", "url": "/?tab=floor", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
